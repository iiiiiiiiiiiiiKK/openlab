# OPENLAB example configuration
#
# Copy to `.env` (or `.env.local`) and adjust. Every value is optional; the
# defaults below are what OPENLAB uses when the variable is absent.
#
# NEVER commit a file containing real API keys. Provider keys and the GitHub
# token are stored encrypted through the UI, not in this file.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
OPENLAB_HOST=127.0.0.1
OPENLAB_PORT=3210
# Set to true (or pass --lan) only if you want the workbench reachable from your
# local network. Requires a restart.
OPENLAB_ALLOW_LAN=false
OPENLAB_LOG_LEVEL=info

# Where projects, logs, media, reports and the SQLite database live.
# OPENLAB_DATA_DIR=C:\OPENLAB_DATA

# ---------------------------------------------------------------------------
# Container resources and policy
# ---------------------------------------------------------------------------
OPENLAB_MAX_PARALLEL_DEPLOYMENTS=1
OPENLAB_CONTAINER_CPU_LIMIT=2.0
OPENLAB_CONTAINER_MEMORY_LIMIT_MB=4096
OPENLAB_CONTAINER_DISK_LIMIT_MB=8192
OPENLAB_CONTAINER_PIDS_LIMIT=512
OPENLAB_CONTAINER_RUN_TIMEOUT_MIN=180
OPENLAB_IDLE_STOP_AFTER_MIN=30
# Outbound network access for project containers. false = blocked by default.
OPENLAB_ALLOW_CONTAINER_NETWORK=false
# Runs projects directly on the host when Docker is unavailable. NOT sandboxed.
# Every project started this way is labelled "host" in the UI and the report.
OPENLAB_ALLOW_HOST_RUNTIME=false

# Ports OPENLAB may map to 127.0.0.1 for running projects.
OPENLAB_PORT_RANGE_START=41000
OPENLAB_PORT_RANGE_END=41999

# ---------------------------------------------------------------------------
# Import limits (defence against malicious or huge archives)
# ---------------------------------------------------------------------------
OPENLAB_MAX_DOWNLOAD_MB=512
OPENLAB_MAX_UNPACKED_MB=2048
OPENLAB_MAX_FILE_COUNT=60000

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# Number of automatic repair attempts before OPENLAB asks for help.
OPENLAB_MAX_REPAIR_ATTEMPTS=3
OPENLAB_AI_DEFAULT_TIMEOUT_S=180
OPENLAB_AI_MAX_TOKENS_DEFAULT=4096
# 0 disables the per-task cost ceiling.
OPENLAB_BUDGET_DEFAULT_USD=0

# Optional: a read-only GitHub token used for private repository imports.
# Prefer Settings -> Credentials in the UI, which encrypts it locally.
# OPENLAB_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Browser automation
# ---------------------------------------------------------------------------
OPENLAB_PLAYWRIGHT_HEADED=false
# chrome | edge | (empty = bundled Chromium)
OPENLAB_BROWSER_CHANNEL=
OPENLAB_BROWSER_VIEWPORT_WIDTH=1440
OPENLAB_BROWSER_VIEWPORT_HEIGHT=900

# ---------------------------------------------------------------------------
# Frontend build (consumed by Vite)
# ---------------------------------------------------------------------------
# OPENLAB_BACKEND_URL=http://127.0.0.1:3210
